{
  "name": "scheura-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply scheura --local",
    "db:migrate:remote": "wrangler d1 migrations apply scheura --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  }
}
